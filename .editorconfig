root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.{java,kt,cs,py,rs}]
indent_size = 4

# gofmt emits tabs unconditionally and is not configurable. Left in the group above,
# an editorconfig-aware editor reformats every Go file on save and gofmt undoes it.
[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
max_line_length = off

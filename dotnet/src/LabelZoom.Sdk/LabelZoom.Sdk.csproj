<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 keeps .NET Framework 4.6.1+ in reach, which still matters in the
         warehouse and ERP estates this SDK targets. net8.0 is built alongside so a modern
         runtime gets its in-box System.Text.Json rather than the compatibility package. -->
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Package Information -->
    <PackageId>LabelZoom.Sdk</PackageId>
    <RootNamespace>LabelZoom.Sdk</RootNamespace>
    <AssemblyName>LabelZoom.Sdk</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>LabelZoom</Authors>
    <Company>RJF Technology Solutions</Company>
    <Product>LabelZoom .NET SDK</Product>
    <Description>Official .NET SDK for the LabelZoom API. Converts barcode labels between ZPL, EPL, TSPL, DPL, PDF, LabelZoom XML/JSON and raster images.</Description>
    <PackageTags>labelzoom;zpl;epl;tspl;dpl;zebra;pdf;conversion;barcode;labels</PackageTags>
    <PackageProjectUrl>https://github.com/labelzoom/labelzoom-zpl-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/labelzoom/labelzoom-zpl-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>labelzoom-mark.png</PackageIcon>

    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Source Link -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Resources\LabelZoom.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\labelzoom-mark.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\..\LICENSE" Link="Resources\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md" Link="Resources\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- System.Text.Json is in-box on net8.0; netstandard2.0 needs the package. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>

</Project>

{
  "id": "request/param-split",
  "note": "C1/C4: every split length is INCHES on the source page as displayed, so a PDF's grid stays put when dpi or scaling changes (an image page measures pixels / dpi, so its grid follows dpi). A length the caller set to 0 (rowGap here) must serialize, not be elided as a falsy default. split.* travels as one nested split object inside ?params=.",
  "given": {
    "client": {
      "apiKey": null
    },
    "source": "pdf",
    "target": "zpl",
    "bodyText": "%PDF-1.4",
    "options": {
      "split": {
        "rows": 10,
        "columns": 3,
        "width": 2.625,
        "height": 1.0,
        "left": 0.1875,
        "top": 0.5,
        "columnGap": 0.125,
        "rowGap": 0.0,
        "skipBlank": true
      }
    }
  },
  "expect": {
    "method": "POST",
    "path": "/api/v2/convert/pdf/to/zpl",
    "headers": {
      "content-type": "application/pdf",
      "accept": "*/*"
    },
    "headersAbsent": [
      "authorization"
    ],
    "headersMatch": {
      "user-agent": "^labelzoom-[a-z0-9]+-sdk/"
    },
    "bodyText": "%PDF-1.4",
    "queryJson": {
      "params": {
        "split": {
          "rows": 10,
          "columns": 3,
          "width": 2.625,
          "height": 1.0,
          "left": 0.1875,
          "top": 0.5,
          "columnGap": 0.125,
          "rowGap": 0.0,
          "skipBlank": true
        }
      }
    }
  }
}

{
  "id": "request/param-collapse-copies",
  "note": "C1/C2: zpl.collapseCopies shares the zpl object with zpl.imageCompression, so setting one must not drop the other. A builder that replaces the whole zpl object on each call loses whichever was set first, and nothing fails: the output silently reverts to one label per page instead of one label with a ^PQ print quantity.",
  "given": {
    "client": {
      "apiKey": null
    },
    "source": "pdf",
    "target": "zpl",
    "bodyText": "%PDF-1.4",
    "options": {
      "zpl": {
        "imageCompression": "Z64",
        "collapseCopies": true
      }
    }
  },
  "expect": {
    "method": "POST",
    "path": "/api/v2/convert/pdf/to/zpl",
    "headers": {
      "content-type": "application/pdf",
      "accept": "*/*"
    },
    "headersAbsent": [
      "authorization"
    ],
    "headersMatch": {
      "user-agent": "^labelzoom-[a-z0-9]+-sdk/"
    },
    "bodyText": "%PDF-1.4",
    "queryJson": {
      "params": {
        "zpl": {
          "imageCompression": "Z64",
          "collapseCopies": true
        }
      }
    }
  }
}

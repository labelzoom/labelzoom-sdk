{
  "id": "request/params-kitchen-sink",
  "note": "C1/C2/C5: every modeled parameter in one request, in a single ?params= object.",
  "given": {
    "client": {
      "apiKey": null
    },
    "source": "pdf",
    "target": "zpl",
    "bodyText": "%PDF-1.4",
    "options": {
      "dpi": 300,
      "rotation": 180,
      "scaling": 75.0,
      "colorMode": "GRAYSCALE",
      "darkness": 60,
      "position": {
        "x": 5,
        "y": 15
      },
      "watermark": false,
      "label": {
        "width": 4.0,
        "height": 6.0
      },
      "pdf": {
        "conversionMode": "IMAGE",
        "pageNumber": 2
      },
      "zpl": {
        "commandsToIgnore": [
          "^PQ",
          "^MD"
        ],
        "imageCompression": "Z64",
        "collapseCopies": true
      },
      "data": [
        {
          "sku": "1234"
        }
      ],
      "labelIndex": 1,
      "layout": {
        "across": 2,
        "gap": 0.1,
        "fill": "SEQUENTIAL"
      },
      "split": {
        "rows": 2,
        "columns": 1,
        "width": 4.0,
        "height": 5.0,
        "left": 0.25,
        "top": 0.25,
        "columnGap": 0.0,
        "rowGap": 0.5,
        "skipBlank": false
      }
    }
  },
  "expect": {
    "method": "POST",
    "path": "/api/v2/convert/pdf/to/zpl",
    "headers": {
      "content-type": "application/pdf",
      "accept": "*/*"
    },
    "queryJson": {
      "params": {
        "dpi": 300,
        "rotation": 180,
        "scaling": 75.0,
        "colorMode": "GRAYSCALE",
        "darkness": 60,
        "position": {
          "x": 5,
          "y": 15
        },
        "watermark": false,
        "label": {
          "width": 4.0,
          "height": 6.0
        },
        "pdf": {
          "conversionMode": "IMAGE",
          "pageNumber": 2
        },
        "zpl": {
          "commandsToIgnore": [
            "^PQ",
            "^MD"
          ],
          "imageCompression": "Z64",
          "collapseCopies": true
        },
        "data": [
          {
            "sku": "1234"
          }
        ],
        "labelIndex": 1,
        "layout": {
          "across": 2,
          "gap": 0.1,
          "fill": "SEQUENTIAL"
        },
        "split": {
          "rows": 2,
          "columns": 1,
          "width": 4.0,
          "height": 5.0,
          "left": 0.25,
          "top": 0.25,
          "columnGap": 0.0,
          "rowGap": 0.5,
          "skipBlank": false
        }
      }
    }
  }
}

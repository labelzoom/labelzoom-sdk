{
  "id": "request/param-unset-defaults-not-emitted",
  "note": "C1: setting targetDpi explicitly to the server default still serializes it, but no OTHER default leaks in alongside it.",
  "given": {
    "client": {
      "apiKey": null
    },
    "source": "zpl",
    "target": "png",
    "bodyText": "^XA^FO20,20^A0N,28^FDhi^FS^XZ",
    "options": {
      "targetDpi": 203
    }
  },
  "expect": {
    "method": "POST",
    "path": "/api/v2/convert/zpl/to/png",
    "queryJson": {
      "params": {
        "targetDpi": 203
      }
    },
    "queryJsonAbsentKeys": {
      "params": [
        "rotation",
        "scaling",
        "colorMode",
        "darkness",
        "watermark"
      ]
    }
  }
}

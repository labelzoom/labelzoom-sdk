{
  "id": "request/param-source-and-target-dpi",
  "note": "C2: when the chosen format pair supports a dpi on each side, the source-side and target-side dpi travel together in the single ?params= JSON object. zpl-to-zpl is the canonical rescaling path: sourceDpi interprets the dots, targetDpi re-authors the output.",
  "given": {
    "client": {
      "apiKey": null
    },
    "source": "zpl",
    "target": "zpl",
    "bodyText": "^XA^FO20,20^A0N,28^FDhi^FS^XZ",
    "options": {
      "sourceDpi": 300,
      "targetDpi": 203
    }
  },
  "expect": {
    "method": "POST",
    "path": "/api/v2/convert/zpl/to/zpl",
    "headers": {
      "content-type": "text/plain",
      "accept": "*/*"
    },
    "headersAbsent": [
      "authorization"
    ],
    "headersMatch": {
      "user-agent": "^labelzoom-[a-z0-9]+-sdk/"
    },
    "bodyText": "^XA^FO20,20^A0N,28^FDhi^FS^XZ",
    "queryJson": {
      "params": {
        "sourceDpi": 300,
        "targetDpi": 203
      }
    }
  }
}

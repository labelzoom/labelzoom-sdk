<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LabelZoom.Sdk targets netstandard2.0, so the same code also runs in a .NET Framework 4.6.1+
    WinForms or console app: add the package and copy Program.vb's two functions across.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LabelZoomVbSample</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LabelZoom.Sdk" Version="1.*" />
  </ItemGroup>

</Project>

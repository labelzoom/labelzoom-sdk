<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="default"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerErrors="true">
  <!--
    executionOrder="default" is load-bearing, not a leftover. ConformanceTest's completeness
    assertion reads a static set that the case runs populate, so it has to execute after them;
    "default" means declaration order, and the assertion is declared last. Randomising the
    order here would make the anti-drift check pass or fail by luck.
  -->
  <!--
    failOnDeprecation is the guard for the bundled cURL client. `curl_close()` shipped in
    0.1.0: a no-op since PHP 8.0, deprecated in 8.5, so it added a notice to every conversion
    while the suite stayed green — because the suite injects MockHttpClient and never ran the
    real transport. CurlHttpClientTest now does, and a deprecation there is a failure.
  -->
  <testsuites>
    <testsuite name="labelzoom-sdk">
      <directory>tests</directory>
    </testsuite>
  </testsuites>

  <source>
    <include>
      <directory>src</directory>
    </include>
  </source>
</phpunit>

{
    "name": "labelzoom/sdk",
    "description": "Official PHP SDK for the LabelZoom API. Converts barcode labels between ZPL, EPL, TSPL, DPL, PDF, LabelZoom XML/JSON and raster images.",
    "type": "library",
    "keywords": ["labelzoom", "zpl", "epl", "tspl", "dpl", "zebra", "barcode", "label", "pdf"],
    "homepage": "https://www.labelzoom.com",
    "license": "MIT",
    "authors": [
        {
            "name": "RJF Technology Solutions LLC",
            "email": "support@labelzoom.com",
            "homepage": "https://www.labelzoom.com"
        }
    ],
    "support": {
        "issues": "https://github.com/labelzoom/labelzoom-sdk/issues",
        "source": "https://github.com/labelzoom/labelzoom-sdk",
        "docs": "https://github.com/labelzoom/labelzoom-sdk/tree/main/php"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "suggest": {
        "ext-curl": "Required by the bundled CurlHttpClient. Not needed if you inject your own PSR-18 client (Guzzle, Symfony HttpClient, ...)."
    },
    "autoload": {
        "psr-4": {
            "LabelZoom\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LabelZoom\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer check --diff",
        "format": "php-cs-fixer fix",
        "analyse": [
            "phpstan analyse",
            "phpstan analyse -c phpstan-tests.neon.dist"
        ]
    },
    "archive": {
        "exclude": [
            "/vendor",
            "/tests",
            "/phpunit.xml.dist",
            "/phpstan.neon.dist",
            "/phpstan-tests.neon.dist",
            "/.php-cs-fixer.dist.php",
            "/.phpunit.cache",
            "/.php-cs-fixer.cache",
            "/composer.lock"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}

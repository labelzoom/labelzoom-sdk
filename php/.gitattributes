# Keep development-only files out of the dist archive Packagist serves. `composer require`
# then installs the library and nothing else — no test suite, no tooling config.
#
# src/, composer.json, README.md and LICENSE must never be listed here; php-test.yml asserts
# the archive still contains them, because an over-eager export-ignore ships a package that
# installs cleanly and then fatals on the first autoload.
/tests/                 export-ignore
/.github/               export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/phpunit.xml.dist       export-ignore
/phpstan.neon.dist      export-ignore
/phpstan-tests.neon.dist export-ignore
/.php-cs-fixer.dist.php export-ignore
